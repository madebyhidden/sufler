<UserControl x:Class="Sufler.Views.InterviewPrep"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Sufler"
             xmlns:v="clr-namespace:Sufler.Views">
    <!-- Подготовка к собеседованию: вакансия, резюме, акценты — и карта вопросов справа -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="300"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*" MinWidth="320" MaxWidth="480"/>
        </Grid.ColumnDefinitions>

        <ContentControl Style="{StaticResource Card}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                <StackPanel Margin="16,14,14,16">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="12" Foreground="{StaticResource Second}" Margin="0,0,7,0"/>
                        <TextBlock Text="Предупредите кандидата, что разговор записывается и расшифровывается. Всё остаётся на этом компьютере."
                                   TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Second}" MaxWidth="520"/>
                    </StackPanel>

                    <TextBlock Text="Кандидат" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox x:Name="CandidateBox" Style="{StaticResource Field}" TextChanged="OnCandidate" Margin="0,0,0,14"/>

                    <DockPanel Margin="0,0,0,5">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="VacancyPick" Style="{StaticResource PillGray}" Content="Из базы" FontSize="12" Padding="10,4" Margin="0,0,6,0" Click="OnPickVacancy"/>
                            <Button Style="{StaticResource PillGray}" Content="Из файла…" FontSize="12" Padding="10,4" Click="OnVacancyFile"/>
                        </StackPanel>
                        <TextBlock Text="Вакансия" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <Grid Margin="0,0,0,14">
                        <TextBox x:Name="VacancyBox" Style="{StaticResource Field}" Height="170" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="OnVacancy"/>
                        <TextBlock x:Name="VacancyHint" Text="Вставьте описание вакансии или выберите её из базы: обязанности, требования, условия" Foreground="{StaticResource Third}"
                                   Margin="11,8,11,0" TextWrapping="Wrap" IsHitTestVisible="False"/>
                    </Grid>

                    <DockPanel Margin="0,0,0,5">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="ResumePick" Style="{StaticResource PillGray}" Content="Из базы" FontSize="12" Padding="10,4" Margin="0,0,6,0" Click="OnPickResume"/>
                            <Button Style="{StaticResource PillGray}" Content="Из файла…" FontSize="12" Padding="10,4" Click="OnResumeFile"/>
                        </StackPanel>
                        <TextBlock Text="Резюме" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <Grid Margin="0,0,0,14">
                        <TextBox x:Name="ResumeBox" Style="{StaticResource Field}" Height="170" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="OnResume"/>
                        <TextBlock x:Name="ResumeHint" Text="Вставьте резюме, загрузите файл или выберите из базы. Оно не обязано совпадать с вакансией" Foreground="{StaticResource Third}"
                                   Margin="11,8,11,0" TextWrapping="Wrap" IsHitTestVisible="False"/>
                    </Grid>

                    <TextBlock Text="На что смотреть особенно" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <Grid Margin="0,0,0,16">
                        <TextBox x:Name="NotesBox" Style="{StaticResource Field}" Height="60" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="OnNotes"/>
                        <TextBlock x:Name="NotesHint" Text="Необязательно: «важна самостоятельность», «проверить опыт с Kafka»" Foreground="{StaticResource Third}"
                                   Margin="11,8,11,0" TextWrapping="Wrap" IsHitTestVisible="False"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="BuildButton" Style="{StaticResource Pill}" Click="OnBuild">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE945;" FontSize="13" Margin="0,0,8,0"/>
                                <TextBlock x:Name="BuildText" Text="Собрать карту вопросов"/>
                            </StackPanel>
                        </Button>
                        <TextBlock Text="{Binding PrepNote}" VerticalAlignment="Center" Foreground="{StaticResource Second}" Margin="12,0,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <TextBlock Text="Вакансия и резюме сохранятся в «Вакансии и резюме», когда соберёте карту, — в следующий раз их не придётся загружать заново."
                               TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Third}" Margin="0,12,0,0"/>
                    <TextBlock x:Name="DeepNote" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Second}" Margin="0,6,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </ContentControl>

        <ContentControl Grid.Column="2" Style="{StaticResource Card}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="16,10,12,10">
                    <Button x:Name="StartButton" DockPanel.Dock="Right" Style="{StaticResource Pill}" FontSize="12.5" Padding="14,6" Click="OnStart" IsEnabled="{Binding AsrReady}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE720;" FontSize="12" Margin="0,0,7,0"/>
                            <TextBlock Text="Начать собеседование"/>
                        </StackPanel>
                    </Button>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE707;" FontSize="13" Foreground="{StaticResource Second}" Margin="0,0,7,0"/>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Карта вопросов"/>
                    </StackPanel>
                </DockPanel>
                <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource Line}"/>
                <v:PlanView x:Name="Plan" EmptyText="Здесь появится карта: обязательные вопросы по требованиям, кейсы на бизнес-логику, вопросы, чтобы понять человека, и вопросы с подковыркой.&#x0a;&#x0a;Можно начать и без карты — уточнения по ходу разговора всё равно будут."/>
            </DockPanel>
        </ContentControl>
    </Grid>
</UserControl>
