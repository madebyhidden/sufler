<UserControl x:Class="Sufler.Views.SetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Sufler">
    <UserControl.Resources>
        <Style x:Key="FeatureCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="6"/>
        </Style>
        <Style x:Key="FeatureTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style x:Key="FeatureNote" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Second}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
            <Setter Property="LineHeight" Value="18"/>
        </Style>
        <Style x:Key="FeatureIcon" TargetType="TextBlock" BasedOn="{StaticResource Icon}">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Margin" Value="0,2,12,0"/>
            <Setter Property="DockPanel.Dock" Value="Left"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource Page}">
        <Grid MaxWidth="780" Margin="30,26,30,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Шаг 1: знакомство -->
            <StackPanel x:Name="Step0" VerticalAlignment="Center">
                <Image Source="/Assets/icon.png" Width="92" Height="92" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="Суфлёр" FontSize="34" FontWeight="Bold" FontFamily="{StaticResource TitleFont}" HorizontalAlignment="Center" Margin="0,12,0,4"/>
                <TextBlock Text="Подсказывает на встречах: что спросили, кого и о чём шла речь" FontSize="16" Foreground="{StaticResource Second}" HorizontalAlignment="Center" Margin="0,0,0,18"/>
                <UniformGrid Columns="2">
                    <Border Style="{StaticResource FeatureCard}"><DockPanel>
                        <TextBlock Style="{StaticResource FeatureIcon}" Text="&#xE720;"/>
                        <StackPanel><TextBlock Style="{StaticResource FeatureTitle}" Text="Живая расшифровка"/>
                            <TextBlock Style="{StaticResource FeatureNote}" Text="Речь превращается в текст прямо во время звонка — и ваш голос, и собеседников."/></StackPanel></DockPanel></Border>
                    <Border Style="{StaticResource FeatureCard}"><DockPanel>
                        <TextBlock Style="{StaticResource FeatureIcon}" Text="&#xE897;"/>
                        <StackPanel><TextBlock Style="{StaticResource FeatureTitle}" Text="Последний вопрос"/>
                            <TextBlock Style="{StaticResource FeatureNote}" Text="Суфлёр ловит вопрос, показывает, кому он адресован, тему и короткий контекст. Риторические пропускает."/></StackPanel></DockPanel></Border>
                    <Border Style="{StaticResource FeatureCard}"><DockPanel>
                        <TextBlock Style="{StaticResource FeatureIcon}" Text="&#xEA8F;"/>
                        <StackPanel><TextBlock Style="{StaticResource FeatureTitle}" Text="«Вопрос к вам»"/>
                            <TextBlock Style="{StaticResource FeatureNote}" Text="Назовёте своё имя — карточка с обращением к вам выделится цветом и придёт уведомление."/></StackPanel></DockPanel></Border>
                    <Border Style="{StaticResource FeatureCard}"><DockPanel>
                        <TextBlock Style="{StaticResource FeatureIcon}" Text="&#xE716;"/>
                        <StackPanel><TextBlock Style="{StaticResource FeatureTitle}" Text="Кто говорит"/>
                            <TextBlock Style="{StaticResource FeatureNote}" Text="Собеседники различаются по голосу; каждому можно дать имя."/></StackPanel></DockPanel></Border>
                    <Border Style="{StaticResource FeatureCard}"><DockPanel>
                        <TextBlock Style="{StaticResource FeatureIcon}" Text="&#xE8F1;"/>
                        <StackPanel><TextBlock Style="{StaticResource FeatureTitle}" Text="База знаний"/>
                            <TextBlock Style="{StaticResource FeatureNote}" Text="Факты из встреч копятся сами и обновляются, когда цифры меняются. Туда же — ваши документы и чат по ним."/></StackPanel></DockPanel></Border>
                    <Border Style="{StaticResource FeatureCard}"><DockPanel>
                        <TextBlock Style="{StaticResource FeatureIcon}" Text="&#xE72E;"/>
                        <StackPanel><TextBlock Style="{StaticResource FeatureTitle}" Text="Всё на этом компьютере"/>
                            <TextBlock Style="{StaticResource FeatureNote}" Text="Модели работают локально. Звук и тексты никуда не отправляются, интернет нужен только чтобы один раз скачать модели."/></StackPanel></DockPanel></Border>
                </UniformGrid>
            </StackPanel>

            <!-- Шаг 2: модели -->
            <DockPanel x:Name="Step1" Visibility="Collapsed">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Модели" FontSize="28" FontWeight="Bold" FontFamily="{StaticResource TitleFont}"/>
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Second}" Margin="0,6,0,4" FontSize="14"
                               Text="Суфлёр работает на моделях, которые лежат на вашем компьютере. Их нужно скачать один раз — дальше интернет не понадобится."/>
                    <TextBlock x:Name="ProfileNote" TextWrapping="Wrap" Foreground="{StaticResource Accent}" Margin="0,0,0,12" FontSize="13"/>
                </StackPanel>
                <TextBlock x:Name="DownloadNote" DockPanel.Dock="Bottom" TextWrapping="Wrap" Foreground="{StaticResource Second}" FontSize="12.5" Margin="2,8,0,0"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <ItemsControl x:Name="ModelList" Focusable="False" Margin="0,0,6,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,0,0,7">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE74D;" FontSize="13" Margin="8,0,-4,0" Click="OnDeleteModel"
                                                ToolTip="Удалить с диска. Если модель понадобится, приложение скачает её заново"
                                                Visibility="{Binding CanDelete, Converter={StaticResource Vis}}"/>
                                        <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="14,0,0,0" MinWidth="74">
                                            <TextBlock Text="{Binding SizeText}" Foreground="{StaticResource Second}" HorizontalAlignment="Right" FontSize="12.5"/>
                                            <TextBlock Text="{Binding State}" Foreground="{StaticResource Good}" HorizontalAlignment="Right" FontSize="12" FontWeight="Medium"/>
                                        </StackPanel>
                                        <Grid DockPanel.Dock="Left" Width="26" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" Foreground="{StaticResource Third}" Visibility="{Binding Ready, Converter={StaticResource Vis}, ConverterParameter=!}"/>
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" Foreground="{StaticResource Good}" Visibility="{Binding Ready, Converter={StaticResource Vis}}"/>
                                        </Grid>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Note}" Foreground="{StaticResource Second}" FontSize="12.5"/>
                                            <ProgressBar Value="{Binding Progress}" Maximum="1" Height="4" Margin="0,6,0,0" Foreground="{StaticResource Accent}" Background="{StaticResource Soft}" BorderThickness="0"
                                                         Visibility="{Binding Ready, Converter={StaticResource Vis}, ConverterParameter=!}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

            <!-- Шаг 3: готовность -->
            <StackPanel x:Name="Step2" Visibility="Collapsed" VerticalAlignment="Center">
                <TextBlock Text="Готовность" FontSize="28" FontWeight="Bold" FontFamily="{StaticResource TitleFont}"/>
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Second}" Margin="0,6,0,14" FontSize="14"
                           Text="Суфлёр слушает микрофон и звук, который играет компьютер, — так он слышит и вас, и собеседников в любом приложении для звонков."/>
                <ItemsControl x:Name="CheckList" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="14,11" Margin="0,0,0,7">
                                <DockPanel>
                                    <Ellipse DockPanel.Dock="Right" Width="10" Height="10" Fill="{Binding Dot}" VerticalAlignment="Center" Margin="12,0,2,0"/>
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="18" Foreground="{StaticResource Accent}" Width="28" Margin="0,0,10,0"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Note}" Foreground="{StaticResource Second}" FontSize="12.5" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Кнопки и точки-шаги -->
            <DockPanel Grid.Row="1" Margin="0,16,0,0">
                <Button x:Name="NextButton" DockPanel.Dock="Right" Style="{StaticResource Pill}" Content="Дальше" Padding="26,9" Click="OnNext"/>
                <Button x:Name="BackButton" DockPanel.Dock="Right" Style="{StaticResource PillGray}" Content="Назад" Margin="0,0,10,0" Padding="18,9" Click="OnBack" Visibility="Collapsed"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="Dot0" Width="8" Height="8" Fill="{StaticResource Accent}" Margin="2,0,6,0"/>
                    <Ellipse x:Name="Dot1" Width="8" Height="8" Fill="{StaticResource Third}" Margin="0,0,6,0"/>
                    <Ellipse x:Name="Dot2" Width="8" Height="8" Fill="{StaticResource Third}"/>
                    <TextBlock x:Name="DiskNote" Foreground="{StaticResource Second}" FontSize="12.5" Margin="14,0,0,0"/>
                    <Button x:Name="FolderButton" Style="{StaticResource PillGray}" Content="Открыть папку с моделями" FontSize="12" Padding="10,5" Margin="12,0,0,0" Click="OnOpenFolder"/>
                </StackPanel>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
