<UserControl x:Class="Sufler.Views.KnowledgeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Sufler"
             xmlns:v="clr-namespace:Sufler.Views">
    <Grid Margin="18,14,18,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="2,0,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource PillGray}" Padding="14,8" Margin="0,0,10,0" Click="OnAddFiles">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" Margin="0,0,7,0"/>
                        <TextBlock Text="Добавить файлы"/>
                    </StackPanel>
                </Button>
                <Button x:Name="RecordButton" Style="{StaticResource Pill}" Click="OnRecord" IsEnabled="{Binding AsrReady}" ToolTip="Ctrl+R">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="RecordIcon" Style="{StaticResource Icon}" Text="&#xE720;" FontSize="13" Margin="0,0,8,0"/>
                        <TextBlock x:Name="RecordText" Text="Начать запись"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="База знаний" FontSize="22" FontWeight="SemiBold" FontFamily="{StaticResource TitleFont}"/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Border Style="{StaticResource Chip}"><TextBlock Style="{StaticResource ChipText}"><Run Text="Фактов: "/><Run Text="{Binding Facts.Count, Mode=OneWay}"/></TextBlock></Border>
                    <Border Style="{StaticResource Chip}"><TextBlock Style="{StaticResource ChipText}"><Run Text="Документов: "/><Run Text="{Binding Docs.Count, Mode=OneWay}"/></TextBlock></Border>
                    <Border Style="{StaticResource Chip}"><TextBlock Style="{StaticResource ChipText}"><Run Text="Встреч: "/><Run Text="{Binding Meetings.Count, Mode=OneWay}"/></TextBlock></Border>
                    <TextBlock Text="{Binding KbStatus}" FontSize="12" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="4,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="320"/>
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Background="{StaticResource WarnSoft}" CornerRadius="12" Padding="14,10" Margin="0,0,0,14"
                Visibility="{Binding ErrorText, Converter={StaticResource Vis}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="11" Click="OnCloseError"/>
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE7BA;" Foreground="{StaticResource Warn}" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="280"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <!-- Факты и документы -->
            <ContentControl Style="{StaticResource Card}" AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
                <DockPanel Background="Transparent">
                    <Border DockPanel.Dock="Top" Background="{StaticResource Soft}" CornerRadius="19" Padding="4" Margin="12">
                        <UniformGrid Columns="2">
                            <RadioButton x:Name="TabFacts" Style="{StaticResource TabPill}" GroupName="kb" IsChecked="True" Checked="OnTab">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xEA80;" FontSize="13" Margin="0,0,6,0"/>
                                    <TextBlock><Run Text="Факты · "/><Run Text="{Binding Facts.Count, Mode=OneWay}"/></TextBlock>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="TabDocs" Style="{StaticResource TabPill}" GroupName="kb" Checked="OnTab">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8A5;" FontSize="13" Margin="0,0,6,0"/>
                                    <TextBlock><Run Text="Документы · "/><Run Text="{Binding Docs.Count, Mode=OneWay}"/></TextBlock>
                                </StackPanel>
                            </RadioButton>
                        </UniformGrid>
                    </Border>
                    <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource Line}"/>
                    <Grid>
                        <Grid x:Name="FactsPane">
                            <StackPanel VerticalAlignment="Center" Margin="28" Visibility="{Binding Facts.Count, Converter={StaticResource Vis}, ConverterParameter=!}">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xEA80;" FontSize="30" Foreground="{StaticResource Third}"/>
                                <TextBlock Style="{StaticResource HintText}" Margin="0,10,0,0"
                                           Text="Факты собираются сами после каждой встречи: цифры, решения, сроки, кто за что отвечает.&#x0a;Их можно добавлять и править через чат справа: «запомни, что…»."/>
                            </StackPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" local:Ui.Wheel="True" Focusable="False">
                                <ItemsControl ItemsSource="{Binding Facts}" Margin="12,12,6,6" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource Soft}" CornerRadius="10" Padding="10,9" Margin="0,0,0,6">
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE74D;" FontSize="12" VerticalAlignment="Top" ToolTip="Удалить факт" Click="OnDeleteFact"/>
                                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xEA80;" FontSize="13" Foreground="{StaticResource Accent}" VerticalAlignment="Top" Margin="2,3,10,0"/>
                                                    <StackPanel>
                                                        <TextBox Style="{StaticResource Selectable}" Text="{Binding Text, Mode=OneWay}"/>
                                                        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Second}" TextDecorations="Strikethrough" Margin="0,4,0,0"
                                                                   Visibility="{Binding Previous, Converter={StaticResource Vis}}"><Run Text="Было: "/><Run Text="{Binding Previous, Mode=OneWay}"/></TextBlock>
                                                        <TextBlock Text="{Binding Meta}" FontSize="11.5" Foreground="{StaticResource Third}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                        <Grid x:Name="DocsPane" Visibility="Collapsed">
                            <StackPanel VerticalAlignment="Center" Margin="28" Visibility="{Binding Docs.Count, Converter={StaticResource Vis}, ConverterParameter=!}">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="30" Foreground="{StaticResource Third}"/>
                                <TextBlock Style="{StaticResource HintText}" Margin="0,10,0,0"
                                           Text="Перетащите сюда файлы или нажмите «Добавить файлы».&#x0a;PDF, Word, текст, Markdown — всё остаётся на этом компьютере."/>
                            </StackPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                <ItemsControl ItemsSource="{Binding Docs}" Margin="12,12,6,6" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource Soft}" CornerRadius="10" Padding="10,8" Margin="0,0,0,6">
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE74D;" FontSize="12" ToolTip="Убрать из базы (сам файл не удаляется)" Click="OnDeleteDoc"/>
                                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE8A5;" FontSize="18" Foreground="{StaticResource Accent}" Margin="2,0,10,0"/>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Meta}" FontSize="11.5" Foreground="{StaticResource Second}" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </DockPanel>
            </ContentControl>

            <!-- Чат по базе -->
            <ContentControl Grid.Column="2" Style="{StaticResource Card}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="16,12">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8F2;" FontSize="13" Foreground="{StaticResource Second}" Margin="0,0,7,0"/>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Чат по базе"/>
                    </StackPanel>
                    <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource Line}"/>
                    <v:ChatPanel Placeholder="Вопрос по базе знаний…"
                                 Hint="Спросите что-нибудь по фактам, документам и встречам.&#x0a;Или попросите: «запомни, что…», «исправь…», «удали факт про…», «проведи аудит фактов»."/>
                </DockPanel>
            </ContentControl>
        </Grid>
    </Grid>
</UserControl>
