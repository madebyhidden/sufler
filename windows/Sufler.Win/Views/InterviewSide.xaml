<UserControl x:Class="Sufler.Views.InterviewSide"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Sufler"
             xmlns:v="clr-namespace:Sufler.Views">
    <!-- Правая панель собеседования: суфлёр по ходу разговора, карта, оценка, чат -->
    <ContentControl Style="{StaticResource Card}">
        <DockPanel>
            <Border DockPanel.Dock="Top" Background="{StaticResource Soft}" CornerRadius="19" Padding="4" Margin="12">
                <UniformGrid Columns="4">
                    <RadioButton x:Name="TabLive" Style="{StaticResource TabPill}" GroupName="iv" IsChecked="True" Checked="OnTab" Content="Суфлёр"/>
                    <RadioButton x:Name="TabPlan" Style="{StaticResource TabPill}" GroupName="iv" Checked="OnTab" Content="Карта"/>
                    <RadioButton x:Name="TabReport" Style="{StaticResource TabPill}" GroupName="iv" Checked="OnTab" Content="Оценка"/>
                    <RadioButton x:Name="TabChat" Style="{StaticResource TabPill}" GroupName="iv" Checked="OnTab" Content="Чат"/>
                </UniformGrid>
            </Border>
            <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource Line}"/>
            <Grid>
                <ScrollViewer x:Name="LivePane" VerticalScrollBarVisibility="Auto" local:Ui.Wheel="True" Focusable="False">
                    <StackPanel x:Name="Live" Margin="14,14,10,10"/>
                </ScrollViewer>
                <v:PlanView x:Name="PlanPane" Visibility="Collapsed"/>
                <DockPanel x:Name="ReportPane" Visibility="Collapsed">
                    <WrapPanel x:Name="ReportButtons" DockPanel.Dock="Bottom" Margin="14,4,14,14"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" local:Ui.Wheel="True" Focusable="False">
                        <StackPanel x:Name="Report" Margin="16,14,10,6"/>
                    </ScrollViewer>
                </DockPanel>
                <v:ChatPanel x:Name="ChatPane" Visibility="Collapsed"
                             Hint="Спросите что-нибудь по этому собеседованию — отвечу по расшифровке, вакансии и оценке." Placeholder="Вопрос по собеседованию…"/>
            </Grid>
        </DockPanel>
    </ContentControl>
</UserControl>
