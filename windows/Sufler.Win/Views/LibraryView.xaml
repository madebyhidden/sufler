<UserControl x:Class="Sufler.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Sufler">
    <!-- Вакансии и резюме: база режима собеседований вместо базы знаний -->
    <Grid Margin="18,14,18,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="2,0,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource PillGray}" Padding="14,8" Margin="0,0,10,0" Click="OnVacancyFile">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8E5;" FontSize="12" Margin="0,0,7,0"/>
                        <TextBlock Text="Из файла"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Pill}" Click="OnNewVacancy">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" Margin="0,0,8,0"/>
                        <TextBlock Text="Новая вакансия"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Вакансии и резюме" FontSize="22" FontWeight="SemiBold" FontFamily="{StaticResource TitleFont}" TextTrimming="CharacterEllipsis"/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Border Style="{StaticResource Chip}"><TextBlock Style="{StaticResource ChipText}"><Run Text="Вакансий: "/><Run Text="{Binding Vacancies.Count, Mode=OneWay}"/></TextBlock></Border>
                    <Border Style="{StaticResource Chip}"><TextBlock Style="{StaticResource ChipText}"><Run Text="Резюме: "/><Run Text="{Binding Resumes.Count, Mode=OneWay}"/></TextBlock></Border>
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Background="{StaticResource WarnSoft}" CornerRadius="12" Padding="14,10" Margin="0,0,0,14"
                Visibility="{Binding ErrorText, Converter={StaticResource Vis}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="11" Click="OnCloseError"/>
                <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ListColumn" Width="230" MinWidth="52"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*" MinWidth="280"/>
                <ColumnDefinition x:Name="GapColumn" Width="0"/>
                <ColumnDefinition x:Name="ResumeColumn" Width="0" MaxWidth="400"/>
            </Grid.ColumnDefinitions>

            <!-- Вакансии; когда открыт кандидат — узкая полоска, нажатие разворачивает список обратно -->
            <ContentControl Style="{StaticResource Card}">
                <Grid>
                    <DockPanel x:Name="ListFull">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="16,12,16,12">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE821;" FontSize="13" Foreground="{StaticResource Second}" Margin="0,0,7,0"/>
                            <TextBlock Style="{StaticResource CardTitle}" Text="Вакансии"/>
                        </StackPanel>
                        <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource Line}"/>
                        <Button x:Name="LooseButton" DockPanel.Dock="Bottom" Style="{StaticResource SideButton}" Margin="8" Click="OnLoose" Visibility="{Binding HasLooseResumes, Converter={StaticResource Vis}}">
                            <TextBlock Text="Без вакансии"/>
                        </Button>
                        <ListBox x:Name="VacancyList" ItemsSource="{Binding Vacancies}" SelectedItem="{Binding LibVacancy, Mode=TwoWay}" Background="Transparent" BorderThickness="0" Margin="6"
                                 ItemContainerStyle="{StaticResource MeetingItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <StackPanel.ContextMenu>
                                            <ContextMenu><MenuItem Header="Удалить вакансию и её резюме" Click="OnDeleteVacancy"/></ContextMenu>
                                        </StackPanel.ContextMenu>
                                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="Medium"/>
                                        <TextBlock Text="{Binding Subtitle}" FontSize="11.5" Foreground="{StaticResource Second}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                    <Button x:Name="ListRail" Visibility="Collapsed" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="OnExpandList" ToolTip="Показать список вакансий"
                            VerticalContentAlignment="Top" FocusVisualStyle="{x:Null}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button"><Border Background="Transparent"><ContentPresenter/></Border></ControlTemplate>
                        </Button.Template>
                        <StackPanel Margin="0,14,0,0">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE700;" Foreground="{StaticResource Accent}" Margin="0,0,0,10"/>
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE821;" Foreground="{StaticResource Second}" Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding Vacancies.Count}" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Second}"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </ContentControl>

            <!-- Открытая вакансия и её кандидаты -->
            <ContentControl Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <ScrollViewer x:Name="VacancyPane" VerticalScrollBarVisibility="Auto" Focusable="False">
                        <StackPanel Margin="16,14,14,16">
                            <StackPanel x:Name="VacancyFields">
                                <TextBox x:Name="VacancyTitle" Style="{StaticResource Plain}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" TextChanged="OnVacancyEdited" Margin="0,0,0,12"/>
                                <TextBlock Text="Описание" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <TextBox x:Name="VacancyText" Style="{StaticResource Field}" Height="200" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="OnVacancyEdited" Margin="0,0,0,12"/>
                                <TextBlock Text="На что смотреть особенно" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <TextBox x:Name="VacancyNotes" Style="{StaticResource Field}" Height="56" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="OnVacancyEdited" Margin="0,0,0,14"
                                         ToolTip="Подставится в каждое собеседование по этой вакансии"/>
                            </StackPanel>
                            <TextBlock x:Name="LooseTitle" Text="Резюме без вакансии" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" Visibility="Collapsed"/>
                            <WrapPanel Margin="0,0,0,8">
                                <TextBlock x:Name="CandidatesTitle" Text="КАНДИДАТЫ" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource Second}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <Button x:Name="ResumeFiles" Style="{StaticResource PillSoft}" FontSize="12" Padding="10,4" Margin="0,0,6,0" Click="OnResumeFiles" Content="Из файлов" ToolTip="Можно выбрать сразу несколько резюме"/>
                                <Button x:Name="ResumePaste" Style="{StaticResource PillSoft}" FontSize="12" Padding="10,4" Click="OnNewResume" Content="Вставить"/>
                            </WrapPanel>
                            <ItemsControl ItemsSource="{Binding LibResumes}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,6">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource RoundButton}" Width="34" Height="34" Content="&#xE8FA;" Background="{StaticResource AccentSoft}" Foreground="{StaticResource Accent}"
                                                    Margin="8,0,0,0" Click="OnStartInterview" ToolTip="Новое собеседование с этим кандидатом"/>
                                            <Button Click="OnPickResume" Cursor="Hand" FocusVisualStyle="{x:Null}" HorizontalContentAlignment="Stretch">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border CornerRadius="9" Padding="0,8,10,8">
                                                            <!-- Цвет итога собеседования; кто ещё не собеседовался — обычный серый фон -->
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="{Binding ResultColor, Converter={StaticResource HexBrush}, ConverterParameter=0.1}"/>
                                                                    <Style.Triggers><DataTrigger Binding="{Binding ResultColor}" Value=""><Setter Property="Background" Value="{StaticResource Soft}"/></DataTrigger></Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <ContentPresenter/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                                <DockPanel>
                                                    <Border DockPanel.Dock="Left" Width="4" CornerRadius="2" Margin="6,0,9,0" Background="{Binding ResultColor, Converter={StaticResource HexBrush}}"/>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" FontWeight="Medium" TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding ResultText}" FontSize="11.5" TextWrapping="Wrap">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{Binding ResultColor, Converter={StaticResource HexBrush}}"/>
                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                    <Style.Triggers><DataTrigger Binding="{Binding ResultColor}" Value=""><Setter Property="Foreground" Value="{StaticResource Second}"/><Setter Property="FontWeight" Value="Normal"/></DataTrigger></Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Button>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="NoResumes" Text="Резюме пока нет. Можно выбрать сразу несколько файлов — каждый станет кандидатом." TextWrapping="Wrap" Foreground="{StaticResource Second}"/>
                        </StackPanel>
                    </ScrollViewer>
                    <StackPanel x:Name="NoVacancy" Margin="30,70,30,0" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE821;" FontSize="30" Foreground="{StaticResource Third}"/>
                        <TextBlock Style="{StaticResource HintText}" Margin="0,10,0,0"
                                   Text="Добавьте вакансию — вставьте описание или загрузите файл. Под ней храните резюме кандидатов: собеседование по ним начинается в один клик, без загрузки с нуля."/>
                    </StackPanel>
                </Grid>
            </ContentControl>

            <!-- Кандидат -->
            <ContentControl x:Name="ResumeCard" Grid.Column="4" Style="{StaticResource Card}" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel Margin="16,14,14,16">
                        <DockPanel Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="11" Click="OnCloseResume" ToolTip="Закрыть"/>
                            <TextBox x:Name="ResumeName" Style="{StaticResource Plain}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" TextChanged="OnResumeEdited"/>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock Text="Вакансия" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox x:Name="ResumeVacancy" Padding="8,4" DisplayMemberPath="Title" SelectionChanged="OnResumeMoved"/>
                        </DockPanel>
                        <StackPanel x:Name="ResultBox" Margin="0,0,0,12"/>
                        <Button x:Name="StartButton" Style="{StaticResource Pill}" HorizontalAlignment="Left" Click="OnStartSelected" Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8FA;" FontSize="13" Margin="0,0,8,0"/>
                                <TextBlock x:Name="StartText" Text="Начать собеседование"/>
                            </StackPanel>
                        </Button>
                        <TextBlock Text="Резюме" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox x:Name="ResumeText" Style="{StaticResource Field}" Height="380" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="OnResumeEdited" Margin="0,0,0,12"/>
                        <Button Style="{StaticResource PillGray}" Content="Удалить резюме" FontSize="12" Padding="10,5" HorizontalAlignment="Left" Click="OnDeleteResume"/>
                    </StackPanel>
                </ScrollViewer>
            </ContentControl>
        </Grid>
    </Grid>
</UserControl>
