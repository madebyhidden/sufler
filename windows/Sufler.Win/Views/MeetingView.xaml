<UserControl x:Class="Sufler.Views.MeetingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Sufler"
             xmlns:v="clr-namespace:Sufler.Views">
    <UserControl.Resources>
        <!-- Реплика в расшифровке -->
        <DataTemplate x:Key="TurnTemplate">
            <StackPanel x:Name="box" HorizontalAlignment="Left" Margin="0,0,56,8" MaxWidth="640">
                <StackPanel x:Name="who" Orientation="Horizontal" Margin="4,0,0,3">
                    <Ellipse Width="7" Height="7" Fill="{Binding VoiceKey, Converter={StaticResource VoiceBrush}}" VerticalAlignment="Center" Margin="0,1,5,0"/>
                    <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding VoiceKey, Converter={StaticResource VoiceBrush}}"/>
                </StackPanel>
                <Border x:Name="bub" Background="{StaticResource Soft}" CornerRadius="14" Padding="12,8">
                    <TextBox x:Name="txt" Style="{StaticResource Selectable}" Text="{Binding Text, Mode=OneWay}">
                        <TextBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Копировать" Command="ApplicationCommands.Copy"/>
                                <MenuItem Header="Переслушать" Click="OnPlayTurn" Visibility="{Binding CanPlay, Converter={StaticResource Vis}}"/>
                                <MenuItem Header="Назвать собеседника по имени…" Click="OnRenameVoice"
                                          Visibility="{Binding VoiceKey, Converter={StaticResource Vis}}"/>
                            </ContextMenu>
                        </TextBox.ContextMenu>
                    </TextBox>
                </Border>
                <StackPanel x:Name="meta" Orientation="Horizontal" Margin="4,3,4,0">
                    <TextBlock x:Name="metaMe" Text="Я  " FontSize="11" FontWeight="Medium" Foreground="{StaticResource Third}" Visibility="Collapsed"/>
                    <TextBlock Text="{Binding TimeText}" FontSize="11" Foreground="{StaticResource Third}" VerticalAlignment="Center"/>
                    <Button x:Name="play" Style="{StaticResource IconButton}" Content="&#xE768;" FontSize="10" Width="20" Height="20" Margin="4,-2,0,-2" Click="OnPlayTurn"
                            ToolTip="Переслушать эту реплику" Visibility="{Binding CanPlay, Converter={StaticResource Vis}}"/>
                </StackPanel>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMe}" Value="True">
                    <Setter TargetName="box" Property="HorizontalAlignment" Value="Right"/>
                    <Setter TargetName="box" Property="Margin" Value="56,0,0,8"/>
                    <Setter TargetName="who" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="bub" Property="Background" Value="{StaticResource AccentSoft}"/>
                    <Setter TargetName="meta" Property="HorizontalAlignment" Value="Right"/>
                    <Setter TargetName="metaMe" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Live}" Value="True">
                    <Setter TargetName="txt" Property="Foreground" Value="{StaticResource Second}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Playing}" Value="True">
                    <Setter TargetName="play" Property="Content" Value="&#xE71A;"/>
                    <Setter TargetName="play" Property="Foreground" Value="{StaticResource Accent}"/>
                    <Setter TargetName="play" Property="ToolTip" Value="Остановить"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Карточка вопроса: свежая — крупная, к владельцу — другого цвета -->
        <DataTemplate x:Key="QuestionTemplate">
            <Border x:Name="card" Background="{StaticResource Soft}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,10">
                <StackPanel>
                    <StackPanel x:Name="forMe" Orientation="Horizontal" Margin="0,0,0,9" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xEA8F;" FontSize="12" Foreground="{StaticResource Alert}" Margin="0,0,6,0"/>
                        <TextBlock Text="ВОПРОС К ВАМ" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource Alert}"/>
                    </StackPanel>
                    <DockPanel Margin="0,0,0,9">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding TimeText}" FontSize="11.5" Foreground="{StaticResource Third}" VerticalAlignment="Center"/>
                        <WrapPanel>
                            <Border x:Name="whomChip" Style="{StaticResource Chip}" Background="{StaticResource AccentSoft}" Margin="0,0,6,2"
                                    Visibility="{Binding Addressee, Converter={StaticResource Vis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="whomIcon" Style="{StaticResource Icon}" Text="&#xE77B;" FontSize="11" Foreground="{StaticResource Accent}" Margin="0,0,5,0"/>
                                    <TextBlock x:Name="whomText" Style="{StaticResource ChipText}" Foreground="{StaticResource Accent}" Text="{Binding AddresseeText}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Chip}" Margin="0,0,6,2" Visibility="{Binding Asker, Converter={StaticResource Vis}}">
                                <TextBlock Style="{StaticResource ChipText}" Text="{Binding AskerText}"/>
                            </Border>
                        </WrapPanel>
                    </DockPanel>
                    <TextBox x:Name="qtext" Style="{StaticResource Selectable}" Text="{Binding Text, Mode=OneWay}" FontSize="14" FontWeight="Medium"/>
                    <Grid Margin="0,10,0,0" Visibility="{Binding Topic, Converter={StaticResource Vis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="bar" Background="{StaticResource AccentLine}" CornerRadius="1.5"/>
                        <StackPanel Grid.Column="1" Margin="9,0,0,0">
                            <TextBlock TextWrapping="Wrap" FontSize="13.5">
                                <Run Text="Тема: " Foreground="{StaticResource Second}"/><Run Text="{Binding Topic, Mode=OneWay}" FontWeight="SemiBold"/>
                            </TextBlock>
                            <TextBox x:Name="ctx" Style="{StaticResource Selectable}" Text="{Binding Context, Mode=OneWay}" FontSize="13.5" Foreground="{StaticResource Second}" Margin="-2,5,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                    </Grid>
                    <Border Background="{StaticResource WarnSoft}" CornerRadius="10" Padding="10" Margin="0,10,0,0" Visibility="{Binding Answer, Converter={StaticResource Vis}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xEA80;" FontSize="12" Foreground="{StaticResource Warn}" Margin="0,0,5,0"/>
                                <TextBlock Text="Подсказка" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Warn}"/>
                            </StackPanel>
                            <TextBox Style="{StaticResource Selectable}" Text="{Binding Answer, Mode=OneWay}" FontSize="13.5"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="hint" Style="{StaticResource PillSoft}" HorizontalAlignment="Left" Margin="0,10,0,0" Click="OnSuggest" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xEA80;" FontSize="12" Margin="0,0,6,0"/>
                            <TextBlock Text="Подсказать ответ"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Big}" Value="True">
                    <Setter TargetName="card" Property="Background" Value="{StaticResource AccentFaint}"/>
                    <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource AccentLine}"/>
                    <Setter TargetName="qtext" Property="FontSize" Value="18"/>
                    <Setter TargetName="qtext" Property="FontWeight" Value="SemiBold"/>
                    <Setter TargetName="ctx" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="hint" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ForMe}" Value="True">
                    <Setter TargetName="card" Property="Background" Value="{StaticResource AlertSoft}"/>
                    <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource Alert}"/>
                    <Setter TargetName="forMe" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="whomChip" Property="Background" Value="{StaticResource AlertSoft}"/>
                    <Setter TargetName="whomIcon" Property="Foreground" Value="{StaticResource Alert}"/>
                    <Setter TargetName="whomText" Property="Foreground" Value="{StaticResource Alert}"/>
                    <Setter TargetName="bar" Property="Background" Value="{StaticResource Alert}"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Big}" Value="True"/>
                        <Condition Binding="{Binding ForMe}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="card" Property="BorderThickness" Value="2"/>
                </MultiDataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="18,14,18,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок встречи -->
        <DockPanel Margin="2,0,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="MicButton" Style="{StaticResource PillGray}" Margin="0,0,10,0" Padding="14,8" Click="OnToggleMic"
                        Visibility="{Binding SelectedIsRecording, Converter={StaticResource Vis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="MicIcon" Style="{StaticResource Icon}" Text="&#xE720;" FontSize="13" Margin="0,0,7,0"/>
                        <TextBlock x:Name="MicText" Text="Выключить микрофон"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource IconButton}" Content="&#xE73F;" Width="36" Height="36" Background="{StaticResource Soft}" Foreground="{StaticResource Second}" Margin="0,0,10,0"
                        Click="OnCompact" ToolTip="Компактный режим: маленькое окно поверх всех"/>
                <Button x:Name="RecordButton" Style="{StaticResource Pill}" Click="OnRecord" IsEnabled="{Binding AsrReady}" ToolTip="Ctrl+R">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="RecordIcon" Style="{StaticResource Icon}" Text="&#xE720;" FontSize="13" Margin="0,0,8,0"/>
                        <TextBlock x:Name="RecordText" Text="Начать запись"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel>
                <TextBox x:Name="TitleBox" Style="{StaticResource Plain}" FontSize="22" FontWeight="SemiBold" FontFamily="{StaticResource TitleFont}"
                         Text="{Binding Selected.Title, Mode=OneWay}" LostFocus="OnTitleDone" KeyDown="OnTitleKey" Margin="-2,0,10,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Border Style="{StaticResource Chip}"><TextBlock Style="{StaticResource ChipText}" Text="{Binding Selected.DayText}"/></Border>
                    <Border Style="{StaticResource Chip}" Visibility="{Binding Selected.TimeText, Converter={StaticResource Vis}}">
                        <TextBlock Style="{StaticResource ChipText}" Text="{Binding Selected.TimeText}"/>
                    </Border>
                    <Border Style="{StaticResource Chip}" Background="#1FE5484D" Visibility="{Binding SelectedIsRecording, Converter={StaticResource Vis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7C8;" FontSize="11" Foreground="{StaticResource Bad}" Margin="0,0,5,0"/>
                            <TextBlock x:Name="Elapsed" Style="{StaticResource ChipText}" Foreground="{StaticResource Bad}" Text="00:00"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <!-- Сообщение об ошибке -->
        <Border Grid.Row="1" Background="{StaticResource WarnSoft}" CornerRadius="12" Padding="14,10" Margin="0,0,0,14"
                Visibility="{Binding ErrorText, Converter={StaticResource Vis}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="11" Click="OnCloseError"/>
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE7BA;" Foreground="{StaticResource Warn}" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- Собеседование, которое ещё не начиналось: подготовка вместо расшифровки -->
        <v:InterviewPrep x:Name="Prep" Grid.Row="2" Visibility="Collapsed"/>

        <Grid x:Name="Workspace" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="300"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="2*" MinWidth="340" MaxWidth="400"/>
            </Grid.ColumnDefinitions>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="170"/>
                </Grid.RowDefinitions>

                <!-- Расшифровка -->
                <ContentControl Style="{StaticResource Card}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="16,12,16,12">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Visibility="{Binding SelectedIsRecording, Converter={StaticResource Vis}}">
                                <Ellipse x:Name="MeDot" Width="7" Height="7" Fill="{StaticResource Third}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Я" FontSize="12" Foreground="{StaticResource Second}" Margin="0,0,12,0"/>
                                <Ellipse x:Name="ThemDot" Width="7" Height="7" Fill="{StaticResource Third}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Звонок" FontSize="12" Foreground="{StaticResource Second}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8BD;" FontSize="13" Foreground="{StaticResource Second}" Margin="0,0,7,0"/>
                                <TextBlock Style="{StaticResource CardTitle}" Text="Расшифровка"/>
                            </StackPanel>
                        </DockPanel>
                        <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource Line}"/>
                        <Grid>
                            <ScrollViewer x:Name="TranscriptScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                          PreviewMouseWheel="OnTranscriptWheel" Focusable="False">
                                <StackPanel Margin="16,16,10,8">
                                    <StackPanel x:Name="TranscriptHint" Margin="0,60,0,0">
                                        <TextBlock x:Name="TranscriptHintIcon" Style="{StaticResource Icon}" Text="&#xE8BD;" FontSize="28" Foreground="{StaticResource Third}"/>
                                        <TextBlock x:Name="TranscriptHintText" Style="{StaticResource HintText}" Text="Здесь появится текст разговора" Margin="0,10,0,0"/>
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding Turns}" ItemTemplate="{StaticResource TurnTemplate}" Focusable="False"/>
                                    <ItemsControl ItemsSource="{Binding Partials}" ItemTemplate="{StaticResource TurnTemplate}" Focusable="False"/>
                                </StackPanel>
                            </ScrollViewer>
                            <!-- Кнопка «вниз» с кольцом-таймером: через сколько расшифровка сама вернётся к последней реплике -->
                            <Button x:Name="FollowButton" Width="42" Height="42" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,18,14"
                                    Cursor="Hand" Click="OnFollow" ToolTip="К последней реплике" Visibility="Collapsed" FocusVisualStyle="{x:Null}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Grid>
                                            <Ellipse Fill="White">
                                                <Ellipse.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Opacity="0.18"/></Ellipse.Effect>
                                            </Ellipse>
                                            <ContentPresenter/>
                                        </Grid>
                                    </ControlTemplate>
                                </Button.Template>
                                <Grid>
                                    <Ellipse Stroke="{StaticResource Line}" StrokeThickness="3" Margin="1.5"/>
                                    <Ellipse x:Name="FollowRing" Stroke="{StaticResource Accent}" StrokeThickness="3" Margin="1.5" StrokeDashCap="Flat"
                                             RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform><RotateTransform Angle="-90"/></Ellipse.RenderTransform>
                                    </Ellipse>
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE74B;" FontSize="14" Foreground="{StaticResource Accent}"/>
                                </Grid>
                            </Button>
                        </Grid>
                    </DockPanel>
                </ContentControl>

                <!-- Заметки -->
                <ContentControl Grid.Row="2" Style="{StaticResource Card}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="16,12,16,0">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE70F;" FontSize="13" Foreground="{StaticResource Second}" Margin="0,0,7,0"/>
                            <TextBlock Style="{StaticResource CardTitle}" Text="Заметки"/>
                        </StackPanel>
                        <Grid Margin="16,8,8,10">
                            <TextBlock x:Name="NotesHint" Text="Пишите по ходу встречи — заметки попадут в итог и в поиск." Foreground="{StaticResource Third}" IsHitTestVisible="False" FontSize="14"/>
                            <TextBox x:Name="NotesBox" Style="{StaticResource Plain}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     Text="{Binding Selected.Notes, Mode=OneWay}" TextChanged="OnNotesChanged"/>
                        </Grid>
                    </DockPanel>
                </ContentControl>
            </Grid>

            <!-- В собеседовании справа — суфлёр, карта, оценка и чат -->
            <v:InterviewSide x:Name="IvSide" Grid.Column="2" Visibility="Collapsed"/>

            <!-- Правая панель: вопрос, чат, итог -->
            <ContentControl x:Name="ClassicSide" Grid.Column="2" Style="{StaticResource Card}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{StaticResource Soft}" CornerRadius="19" Padding="4" Margin="12">
                        <UniformGrid Columns="3">
                            <RadioButton x:Name="TabQuestion" Style="{StaticResource TabPill}" GroupName="side" IsChecked="True" Checked="OnTab">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE897;" FontSize="13" Margin="0,0,6,0"/><TextBlock Text="Вопрос"/></StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="TabChat" Style="{StaticResource TabPill}" GroupName="side" Checked="OnTab">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8F2;" FontSize="13" Margin="0,0,6,0"/><TextBlock Text="Чат"/></StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="TabSummary" Style="{StaticResource TabPill}" GroupName="side" Checked="OnTab">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8FD;" FontSize="13" Margin="0,0,6,0"/><TextBlock Text="Итог"/></StackPanel>
                            </RadioButton>
                        </UniformGrid>
                    </Border>
                    <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource Line}"/>
                    <Grid>
                        <!-- Вопрос -->
                        <ScrollViewer x:Name="QuestionPane" VerticalScrollBarVisibility="Auto" local:Ui.Wheel="True" Focusable="False">
                            <StackPanel Margin="14,14,8,6">
                                <StackPanel Visibility="{Binding PendingQuestion, Converter={StaticResource Vis}}" Margin="0,0,0,12">
                                    <TextBlock Style="{StaticResource Caps}" Text="НОВЫЙ ВОПРОС" Margin="0,0,0,8"/>
                                    <Border Background="{StaticResource AccentFaint}" CornerRadius="14" Padding="14">
                                        <TextBlock TextWrapping="Wrap" FontSize="18" FontWeight="SemiBold"><Run Text="{Binding PendingQuestion, Mode=OneWay}"/><Run Text=" ▍" Foreground="{StaticResource Accent}"/></TextBlock>
                                    </Border>
                                </StackPanel>
                                <DockPanel x:Name="QuestionHead" Margin="0,0,0,8" Visibility="{Binding Questions.Count, Converter={StaticResource Vis}}">
                                    <TextBlock DockPanel.Dock="Right" Text="ищу…" FontSize="11" Foreground="{StaticResource Third}" Visibility="{Binding Detecting, Converter={StaticResource Vis}}"/>
                                    <TextBlock Style="{StaticResource Caps}" Text="ПОСЛЕДНИЙ ВОПРОС"/>
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding Questions}" ItemTemplate="{StaticResource QuestionTemplate}" Focusable="False"/>
                                <StackPanel x:Name="QuestionHint" Margin="24,70,24,0" Visibility="{Binding Questions.Count, Converter={StaticResource Vis}, ConverterParameter=!}">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE897;" FontSize="30" Foreground="{StaticResource Third}"/>
                                    <TextBlock x:Name="QuestionHintText" Style="{StaticResource HintText}" Margin="0,10,0,0"
                                               Text="Здесь появится последний вопрос из разговора: кому он адресован и краткий контекст."/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Чат по встрече -->
                        <v:ChatPanel x:Name="ChatPane" Visibility="Collapsed"
                                     Hint="Спросите что-нибудь по этой встрече — отвечу по всей её расшифровке, итогу и заметкам." Placeholder="Вопрос по этой встрече…"/>

                        <!-- Итог -->
                        <DockPanel x:Name="SummaryPane" Visibility="Collapsed">
                            <WrapPanel x:Name="SummaryButtons" DockPanel.Dock="Bottom" Margin="14,4,14,14">
                                <Button x:Name="RebuildButton" Style="{StaticResource PillSoft}" Margin="0,6,8,0" Click="OnRebuild">
                                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="12" Margin="0,0,6,0"/><TextBlock x:Name="RebuildText" Text="Пересобрать"/></StackPanel>
                                </Button>
                                <Button x:Name="CopyButton" Style="{StaticResource PillSoft}" Margin="0,6,8,0" Click="OnCopySummary">
                                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" FontSize="12" Margin="0,0,6,0"/><TextBlock x:Name="CopyText" Text="Копировать"/></StackPanel>
                                </Button>
                                <Button x:Name="WordButton" Style="{StaticResource PillSoft}" Margin="0,6,8,0" Click="OnWord">
                                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8A5;" FontSize="12" Margin="0,0,6,0"/><TextBlock Text="В Word"/></StackPanel>
                                </Button>
                            </WrapPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" local:Ui.Wheel="True" Focusable="False">
                                <StackPanel Margin="16,14,10,6">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10" Visibility="{Binding Summarizing, Converter={StaticResource Vis}}">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="12" Foreground="{StaticResource Accent}" Margin="0,0,7,0"/>
                                        <TextBlock Text="Составляю итог…" Foreground="{StaticResource Second}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10" Visibility="{Binding CheckingNames, Converter={StaticResource Vis}}">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="12" Foreground="{StaticResource Warn}" Margin="0,0,7,0"/>
                                        <TextBlock Text="Проверяю названия…" Foreground="{StaticResource Second}"/>
                                    </StackPanel>
                                    <!-- «Проверьте названия»: слова, которые распознавание могло исковеркать. Ответы уходят в словарь -->
                                    <Border Background="{StaticResource WarnSoft}" CornerRadius="12" Padding="12,12,12,6" Margin="0,0,0,12"
                                            Visibility="{Binding NameChecks.Count, Converter={StaticResource Vis}}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE70F;" FontSize="12" Foreground="{StaticResource Warn}" Margin="0,0,6,0"/>
                                                <TextBlock Text="Проверьте названия" FontWeight="SemiBold" Foreground="{StaticResource Warn}"/>
                                            </StackPanel>
                                            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Second}" Margin="0,4,0,8"
                                                       Text="Эти слова могли распознаться неверно. Впишите, как правильно, — исправлю во встрече и запомню на будущее."/>
                                            <ItemsControl ItemsSource="{Binding NameChecks}" Focusable="False">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="White" CornerRadius="9" Padding="9" Margin="0,0,0,6">
                                                            <StackPanel>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding HeardText}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                                    <Button Style="{StaticResource IconButton}" Content="&#xE768;" FontSize="10" Width="22" Height="22" Margin="6,0,0,0" Foreground="{StaticResource Accent}"
                                                                            Click="OnPlayCheck" ToolTip="Послушать, как это прозвучало" Visibility="{Binding CanPlay, Converter={StaticResource Vis}}"/>
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding Quote}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Second}" Margin="0,3,0,6"/>
                                                                <DockPanel>
                                                                    <Button DockPanel.Dock="Right" Style="{StaticResource PillGray}" Content="Верно" FontSize="12" Padding="10,5" Margin="6,0,0,0" Click="OnCheckOk"
                                                                            ToolTip="Слово записано правильно — больше не спрашивать"/>
                                                                    <Button DockPanel.Dock="Right" Style="{StaticResource Pill}" Content="Исправить" FontSize="12" Padding="10,5" Margin="6,0,0,0" Click="OnCheckFix"/>
                                                                    <TextBox Style="{StaticResource Field}" Text="{Binding Input, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" KeyDown="OnCheckKey" Padding="7,4"/>
                                                                </DockPanel>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                    <RichTextBox x:Name="SummaryBox" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0" Margin="-5,0,0,0"
                                                 IsDocumentEnabled="False" FontSize="14" Foreground="{StaticResource Ink}" FocusVisualStyle="{x:Null}" IsTabStop="False"/>
                                    <StackPanel x:Name="SummaryHint" Margin="20,56,20,0">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8FD;" FontSize="30" Foreground="{StaticResource Third}"/>
                                        <TextBlock Style="{StaticResource HintText}" Margin="0,10,0,0"
                                                   Text="Итог составляется автоматически после остановки записи: коротко, решения, задачи, открытые вопросы."/>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </Grid>
                </DockPanel>
            </ContentControl>
        </Grid>
    </Grid>
</UserControl>
