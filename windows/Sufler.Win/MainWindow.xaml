<Window x:Class="Sufler.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Sufler.Views"
        Title="Суфлёр" Width="1240" Height="800" MinWidth="960" MinHeight="600"
        Background="{StaticResource Page}" FontFamily="{StaticResource TextFont}" FontSize="13.5" Foreground="{StaticResource Ink}"
        UseLayoutRounding="True" WindowStartupLocation="CenterScreen">
    <Grid>
        <!-- Основное окно: слева встречи, справа открытая встреча или база знаний -->
        <Grid x:Name="MainPanel">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource Side}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                <DockPanel Margin="10,12,10,10">
                    <StackPanel DockPanel.Dock="Top">
                        <Button x:Name="KbButton" Style="{StaticResource SideButton}" Click="OnOpenKb">
                            <DockPanel>
                                <TextBlock x:Name="KbIcon" Style="{StaticResource Icon}" Text="&#xE8F1;" Foreground="{StaticResource Accent}" Width="20" Margin="0,0,8,0"/>
                                <TextBlock x:Name="KbCount" DockPanel.Dock="Right" Text="{Binding Facts.Count}" FontSize="12" Opacity="0.65" VerticalAlignment="Center"/>
                                <TextBlock x:Name="KbText" Text="База знаний" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Button>
                        <Button x:Name="SideRecord" Style="{StaticResource SideButton}" Background="{StaticResource Accent}" Foreground="White" Margin="0,6,0,0"
                                Click="OnRecord" IsEnabled="{Binding AsrReady}" ToolTip="Ctrl+R">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="SideRecordIcon" Style="{StaticResource Icon}" Text="&#xE720;" Width="20" Margin="0,0,8,0"/>
                                <TextBlock x:Name="SideRecordText" Text="Начать запись" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="ListTitle" Text="ВСТРЕЧИ" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource Third}" Margin="9,16,0,4"/>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Margin="2,8,2,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Ellipse x:Name="AsrDot" Width="8" Height="8" Fill="{StaticResource Warn}" Margin="3,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding AsrStatus}" FontSize="12" Foreground="{StaticResource Second}" TextTrimming="CharacterEllipsis" MaxWidth="200"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Ellipse x:Name="LlmDot" Width="8" Height="8" Fill="{StaticResource Warn}" Margin="3,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding LlmStatus}" FontSize="12" Foreground="{StaticResource Second}" TextTrimming="CharacterEllipsis" MaxWidth="200"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6" Visibility="{Binding DeepStatus, Converter={StaticResource Vis}}">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource Accent}" Margin="3,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding DeepStatus}" FontSize="12" Foreground="{StaticResource Second}" TextTrimming="CharacterEllipsis" MaxWidth="200"/>
                        </StackPanel>
                        <Button x:Name="UpdateButton" Style="{StaticResource Pill}" FontSize="12" Padding="10,6" Margin="0,2,0,4" Visibility="Collapsed" Click="OnUpdate"/>
                        <Border Height="1" Background="{StaticResource Line}" Margin="0,4,0,6"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="Настройки" Click="OnSettings" Foreground="{StaticResource Second}"/>
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE73F;" ToolTip="Компактный режим: маленькое окно поверх всех" Click="OnCompact" Foreground="{StaticResource Second}"/>
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xED15;" ToolTip="Отзыв или сообщение об ошибке" Click="OnFeedback" Foreground="{StaticResource Second}"/>
                            <Button x:Name="StatsButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE9D2;" ToolTip="Статистика" Click="OnStats" Foreground="{StaticResource Second}"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE72E;" FontSize="11" Foreground="{StaticResource Second}" Margin="2,0,6,0"/>
                                <TextBlock Text="Всё локально" FontSize="12" Foreground="{StaticResource Second}"/>
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>

                    <ListBox x:Name="MeetingList" Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource MeetingItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="OnMeetingPicked">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <DockPanel.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Удалить встречу" Click="OnDeleteMeeting"/>
                                        </ContextMenu>
                                    </DockPanel.ContextMenu>
                                    <Grid Width="20" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8BD;" FontSize="14" Foreground="{StaticResource Second}" Visibility="{Binding Recording, Converter={StaticResource Vis}, ConverterParameter=!}"/>
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7C8;" FontSize="14" Foreground="{StaticResource Bad}" Visibility="{Binding Recording, Converter={StaticResource Vis}}"/>
                                    </Grid>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding DateText}" FontSize="11.5" Foreground="{StaticResource Second}" Margin="0,1,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1">
                <v:MeetingView x:Name="MeetingPane" Visibility="Collapsed"/>
                <v:KnowledgeView x:Name="KbPane" Visibility="Collapsed"/>
                <v:LibraryView x:Name="LibPane" Visibility="Collapsed"/>
                <v:StatsView x:Name="StatsPane" Visibility="Collapsed"/>
                <StackPanel x:Name="EmptyPane" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8D6;" FontSize="46" Foreground="{StaticResource Accent}"/>
                    <TextBlock x:Name="EmptyTitle" Text="Встреч пока нет" FontSize="22" FontWeight="SemiBold" FontFamily="{StaticResource TitleFont}" HorizontalAlignment="Center" Margin="0,16,0,8"/>
                    <TextBlock x:Name="EmptyText" Style="{StaticResource HintText}" Text="Начните запись — Суфлёр расшифрует разговор,&#x0a;покажет последний вопрос и кому он адресован."/>
                    <Button Style="{StaticResource Pill}" HorizontalAlignment="Center" Margin="0,18,0,0" Click="OnRecord" IsEnabled="{Binding AsrReady}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE720;" Margin="0,0,8,0"/>
                            <TextBlock x:Name="EmptyButtonText" Text="Начать запись"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <!-- «Похоже, начался звонок»: предложение начать запись -->
                <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0" Background="White" CornerRadius="24" Padding="16,8,10,8"
                        BorderBrush="{StaticResource AccentLine}" BorderThickness="1" Visibility="{Binding CallOffer, Converter={StaticResource Vis}}">
                    <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.16"/></Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE717;" Foreground="{StaticResource Accent}" Margin="0,0,10,0"/>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                            <TextBlock Text="Похоже, начался звонок" FontWeight="SemiBold"/>
                            <TextBlock FontSize="12" Foreground="{StaticResource Second}"><Run Text="{Binding CallOffer, Mode=OneWay}"/><Run Text=" включил микрофон"/></TextBlock>
                        </StackPanel>
                        <Button Style="{StaticResource Pill}" Content="Начать запись" FontSize="12.5" Padding="14,6" Click="OnAcceptCall"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="10" Margin="6,0,0,0" Click="OnDismissCall"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <v:CompactView x:Name="CompactPane" Visibility="Collapsed"/>

        <!-- Первый запуск: знакомство, модели, готовность -->
        <v:SetupView x:Name="SetupPane" Visibility="Collapsed"/>
    </Grid>
</Window>
