<Project Sdk="Microsoft.NET.Sdk">
  <!-- Общая логика «Суфлёра» без интерфейса: собирается и проверяется на любой системе -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Sufler</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="org.k2fsa.sherpa.onnx" Version="1.13.8" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <!-- Свежая сборка SQLite: в той, что идёт по умолчанию, есть известная уязвимость -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.13" />
    <PackageReference Include="PdfPig" Version="0.1.11" />
    <PackageReference Include="Concentus" Version="2.2.2" />
  </ItemGroup>
</Project>
